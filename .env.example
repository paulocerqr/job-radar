# Copie para .env e ajuste. Nunca versione o .env.

# --- Postgres (serviço do docker-compose) ---
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=jobradar
POSTGRES_PORTA=5432               # porta publicada em 127.0.0.1 (dev/testes)

# Dentro do compose o host é "postgres"; rodando no host use localhost
DATABASE_URL=postgresql+psycopg://jobradar:troque-esta-senha@postgres:5432/jobradar

# --- Aplicação ---
LOG_FORMAT=json                   # json | text
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
COLETA_NO_WORKER=true             # false no Kubernetes (coleta via CronJob)

# --- Seed (job-radar seed) ---
ADMIN_EMAIL=voce@exemplo.com
ADMIN_NOME=Admin
ADMIN_SENHA=troque-esta-senha

# --- IA ---
# cifra as chaves de API dos providers no banco; gere com `job-radar chave-fernet`.
# Se perder ou trocar, as chaves cadastradas precisam ser cadastradas de novo.
FERNET_KEY=

# --- Próximas fases ---
# SECRET_KEY=
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_TOKEN=
# TELEGRAM_BOT_TOKEN=
# GITHUB_TOKEN=
